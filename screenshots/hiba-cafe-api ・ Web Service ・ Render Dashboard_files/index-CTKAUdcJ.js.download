  query artifactSourcePreview($id: String!) {
    artifactSource(id: $id) {
      id
      name
      buildConfig {
        repoNode {
          id
          sourceBranch
          repo {
            id
            provider
            name
            ownerName
            webURL
          }
        }
      }
      externalImage {
        imageHost
        imageRepository
        imageName
        imageRef
      }
      latestArtifact {
        id
        build {
          id
          status
        }
      }
    }
  }
`),eR=new Ve(z`
