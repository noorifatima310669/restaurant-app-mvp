  query ServerDeployEndedEvents($serviceId: String!, $limit: Int!) {
    serviceEvents(
      serviceId: $serviceId
      include: ["DeployEnded"]
      limit: $limit
    ) {
      events {
        id
        ... on DeployEnded {
          deployId
          reason {
            newDeploy {
              id
            }
            canceledBy {
              id
              email
              avatarDownload {
                url
              }
            }
            canceledWithApiKey
            suspended
          }
        }
      }
    }
  }
