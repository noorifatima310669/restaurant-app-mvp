  fragment sandboxListFields on Sandbox {
    id
    __typename
    status
    createdAt
    startedAt
    endedAt
    networkPolicy
    allowedDomains
    timeoutSeconds
    sourceSnapshotId
    source {
      __typename
      ... on SandboxEmailSource {
        email
      }
      ... on SandboxTemplateSource {
        templateId
      }
    }
    region {
      id
      description
    }
    image {
      name
      registryUrl
    }
    plan {
      name
      cpus
      memoryGb
      storageGb
    }
  }
`,wQ=new Ve(z`
