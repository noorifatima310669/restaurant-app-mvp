  query DiskSnapshotRestores($serviceId: String!, $limit: Int!) {
    serviceEvents(
      serviceId: $serviceId
      include: ["DiskSnapshotRestored"]
      limit: $limit
    ) {
      events {
        id
        timestamp
        ... on DiskSnapshotRestored {
          diskInstanceId
          snapshotCreatedAt
          triggeredByUser {
            id
            email
          }
        }
      }
    }
  }
