const render = new Render();
const sandbox = await render.experimental.sandboxes.create({
  ownerId: "${t}",
});

// Locate the sandbox in the dashboard with this ID
console.log(\`Sandbox ID: \${sandbox.id}\`);

const stream = await render.experimental.sandboxes.exec(sandbox.id, "node /app/agent.js");
for await (const event of stream) {
  if (event.type === "output") {
    process.stdout.write(event.data);
  } else {
    console.log(\`exit code: \${event.exit_code}\`);
  }
}`,snapshot:(e,t)=>e===`python`?`import time

from render import Render

render = Render()
sandboxes = render.experimental.sandboxes
owner_id = "${t}"

# Snapshots capture a running sandbox, so wait for it to start
sandbox = sandboxes.create(owner_id=owner_id)
while sandbox.status != "running":
    if sandbox.status in ("errored", "terminated"):
        raise RuntimeError(f"Sandbox {sandbox.id} is {sandbox.status}")
    time.sleep(2)
    sandbox = sandboxes.from_id(sandbox.id, owner_id=owner_id)

# Wait for the snapshot to finish capturing
snapshot = sandboxes.snapshots.create(sandbox.id, owner_id=owner_id)
while snapshot.status == "creating":
    time.sleep(2)
    snapshot = sandboxes.snapshots.from_id(
        sandbox_group_id=snapshot.sandbox_group_id,
        snapshot_id=snapshot.id,
        owner_id=owner_id,
    )
if snapshot.status == "failed":
    raise RuntimeError(f"Snapshot failed: {snapshot.error}")

# Locate the snapshot in the dashboard with this ID
print(f"Snapshot ID: {snapshot.id}")

# Start a new sandbox from the snapshot
restored = sandboxes.create(owner_id=owner_id, snapshot_id=snapshot.id)
print(f"Restored sandbox ID: {restored.id}")`:`import { Render } from "@renderinc/sdk";

const render = new Render();
const sandboxes = render.experimental.sandboxes;
const ownerId = "${t}";
const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

// Snapshots capture a running sandbox, so wait for it to start
let sandbox = await sandboxes.create({ ownerId });
while (sandbox.status !== "running") {
  if (sandbox.status === "errored" || sandbox.status === "terminated") {
    throw new Error(\`Sandbox \${sandbox.id} is \${sandbox.status}\`);
  }
  await sleep(2000);
  sandbox = await sandboxes.get(sandbox.id, ownerId);
}

// Wait for the snapshot to finish capturing
let snapshot = await sandboxes.snapshots.create({ sandboxId: sandbox.id, ownerId });
while (snapshot.status === "creating") {
  await sleep(2000);
  snapshot = await sandboxes.snapshots.get({
    sandboxGroupId: snapshot.sandboxGroupId,
    snapshotId: snapshot.id,
    ownerId,
  });
}
if (snapshot.status === "failed") {
  throw new Error(\`Snapshot failed: \${snapshot.error}\`);
}

// Locate the snapshot in the dashboard with this ID
console.log(\`Snapshot ID: \${snapshot.id}\`);

