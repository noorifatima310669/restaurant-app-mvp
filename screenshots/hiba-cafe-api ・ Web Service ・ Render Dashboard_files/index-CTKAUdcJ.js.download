        id
        name
        project {
          name
        }
      }
    }
    databasesForOwner(ownerId: $ownerId) {
      id
      __typename
      name
      updatedAt
      suspenders
      environment {
        id
        name
        project {
          name
        }
      }
    }
    redisesForOwner(ownerId: $ownerId) {
      id
      __typename
      name
