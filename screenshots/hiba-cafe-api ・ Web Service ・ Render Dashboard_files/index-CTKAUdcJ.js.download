ion:`When your script is ready, run it to create your sandbox:`},snapshot:{title:`Snapshot sandboxes in code`,description:`Use the Render SDK to snapshot sandboxes and start new ones from them.`,starterTitle:`Snapshot your first sandbox`,runDescription:`When your script is ready, run it to snapshot your sandbox:`}},vle={python:`/sandboxes-sdk-python#snapshot-management`,typescript:`/sandboxes-sdk-typescript#snapshot-management`},yle={sandbox:(e,t)=>e===`python`?`from render import Render
from render.experimental.sandbox import SandboxExecOutput

render = Render()
sandbox = render.experimental.sandboxes.create(
    owner_id="${t}",
)

# Locate the sandbox in the dashboard with this ID
print(f"Sandbox ID: {sandbox.id}")

for event in render.experimental.sandboxes.exec(sandbox.id, "python /app/agent.py"):
    if isinstance(event, SandboxExecOutput):
        print(event.data, end="")
    else:
