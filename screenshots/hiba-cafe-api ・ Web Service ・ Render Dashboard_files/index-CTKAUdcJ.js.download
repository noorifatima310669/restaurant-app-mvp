  fragment deployMinimalFields on Deploy {
    id
    createdAt
    startedAt
    finishedAt
    status
    rollbackSupportStatus
    commitId
    commitShortId
    commitMessage
    commitURL
    imageSHA
    externalImage {
      imageRef
    }
    triggerDetails {
      type
      updatedProperty
      userAgent
      user {
        id
        email
        avatarDownload {
          url
        }
      }
    }
  }
`,Q0=new Ve(z`
  query deploysMinimal($input: DeployFilterInput!) {
    deploys(input: $input) {
      ...deployMinimalFields
    }
  }
